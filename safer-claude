#!/usr/bin/env bash
# =============================================================================
#  safer-claude — run Claude Code in a locked-down container
# =============================================================================
#
#  USAGE
#      safer-claude
#      safer-claude --ro ../../../core --ro ../../../../vendor
#      safer-claude --with-core --with-vendor
#      safer-claude --rw ../../contrib
#      safer-claude --allow www.php.net
#      safer-claude --effort high
#      safer-claude --offline
#      safer-claude --repair
#      safer-claude -- bash
#
#  FLAGS
#      --add PATH      mount a host folder READ-ONLY, in addition to the
#                      current directory. --ro means the same thing
#      --with-core     mount a Drupal folder READ-ONLY, found by name from the
#      --with-modules  repository root: <web root>/core, <web root>/modules,
#      --with-themes   <web root>/themes, <web root>/modules/contrib, or the
#      --with-contrib  composer vendor folder. See section 8b of
#      --with-vendor   lib/safer-common.sh
#      --with-config   the config export folder, read from settings.php
#      --with-all      core, modules, themes, vendor and config in one flag
#      --with-*-rw     any of the above read-WRITE, for example
#                      --with-config-rw or --with-all-rw. Confirmed like --rw
#      --rw PATH       mount a host folder read-WRITE. The agent can change
#                      your Mac through it, so a folder outside the current
#                      directory has to be confirmed
#      --allow HOST    permit one extra network destination for this run only
#      --effort LEVEL  low, medium, high, xhigh or max. See the note below
#      --offline       no network at all (the agent cannot reach the model API,
#                      so this is only useful with `-- bash` for local analysis)
#      --repair        finish the cleanup of a run that died without its exit
#                      trap (kill -9, power loss): placeholders, ignore rules,
#                      generated files, containers, network. Then stop.
#                      See sessions/README.md
#      -- COMMAND      run COMMAND instead of claude
#
#  WHERE THE REST OF THE LOGIC IS
#  The sandbox itself — the sealed network, the gatekeeper, hiding .git, the
#  connection log — is in lib/safer-common.sh, shared with safer-codex and
#  safer-opencode. This file holds only what is specific to Claude Code.
#
#  ---------------------------------------------------------------------------
#  SETTINGS INSIDE THE SANDBOX
#  ---------------------------------------------------------------------------
#  /effort, /model and the rest work normally. Changes apply for the session and
#  are then thrown away — your Mac's settings are never modified.
#
#  DO NOT MOUNT settings.json AS A SINGLE FILE. Claude Code saves a setting by
#  writing a temporary file and renaming it over the real one. A single-file
#  bind mount IS a mount point, and Linux refuses to let a rename replace a
#  mount point. The save then fails with:
#
#      EBUSY: resource busy or locked, rename
#      '/home/agent/.claude/settings.json.tmp...' -> '.../settings.json'
#
#  The read-only flag is not the cause. The same fault occurs on a writable
#  single-file mount.
#
#  So settings.json is a real file inside a throwaway copy of ~/.claude, and
#  the rename works. See build_config() below, and the config strategy essay in
#  lib/safer-common.sh for why the copy is also the stronger security choice.
#
#  Note: --effort sets an environment variable that OVERRIDES /effort for the
#  whole session. Use it for unattended runs; leave it off if you want to change
#  effort while you work.
#
#  SESSION HISTORY: this project's transcript persists, because Claude Code
#  stores transcripts per project and only this project's folder is shared.
#
#  LOGIN: the sandbox has its own login, separate from your Mac's. It is kept in
#
#      <launcher folder>/history/claude/credentials.json
#
#  and renewed there at the end of every run. You log in once, inside the
#  sandbox; after that a run starts authenticated. See seed_credentials() and
#  save_credentials() below for why the Keychain alone could not do this.
# =============================================================================

set -euo pipefail


# ---------------------------------------------------------------------------
#  Find the folder this command lives in, and load the shared machinery.
#
#  We cannot just use the current directory: you run this from your project,
#  not from here. And we cannot use "$0" directly, because that may be a
#  relative path or a symlink.
#
#  BASH_SOURCE[0] is the path to this file. `dirname` strips the filename.
#  `cd ... && pwd -P` turns it into a full path with all symlinks resolved.
# ---------------------------------------------------------------------------
SAFER_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

TOOL="claude"

# shellcheck source=lib/safer-common.sh
source "$SAFER_ROOT/lib/safer-common.sh"


usage() {
    echo "Usage: safer-claude [--add PATH] [--with-core] [--with-modules]"
    echo "                    [--with-themes] [--with-contrib] [--with-vendor]"
    echo "                    [--with-config] [--with-all] [--with-*-rw] [--rw PATH]"
    echo "                    [--allow HOST] [--effort LEVEL] [--offline]"
    echo "                    [-- COMMAND ...]"
    echo "       safer-claude --repair"
    echo ""
    echo "  --add PATH      mount a folder READ-ONLY (--ro means the same)"
    echo "  --with-core     mount <web root>/core read-only, found from the"
    echo "  --with-modules  repository root. Likewise <web root>/modules,"
    echo "  --with-themes   <web root>/themes, <web root>/modules/contrib"
    echo "  --with-contrib  and the composer vendor folder. Saves counting"
    echo "  --with-vendor   ../ in --add"
    echo "  --with-config   mount the config export folder read-only. Its place"
    echo "                  is read from sites/default/settings.php on your Mac;"
    echo "                  the parent of the sync folder is mounted, so config"
    echo "                  split folders come along"
    echo "  --with-all      core, modules, themes, vendor and config in one flag"
    echo "  --with-*-rw     any --with flag read-WRITE: --with-config-rw for a"
    echo "                  config export, --with-all-rw for everything. Each"
    echo "                  folder is confirmed like --rw"
    echo "  --rw PATH       mount a folder read-WRITE. The agent can change"
    echo "                  your Mac through it, so ask for it by name. A"
    echo "                  folder outside your project must be confirmed."
    echo "  --allow HOST    allow one extra destination for this run only"
    echo "  --effort LEVEL  low | medium | high | xhigh | max"
    echo "  --offline       no network at all"
    echo "  --repair        undo what a run killed with kill -9 left behind,"
    echo "                  in the project and in Docker, then stop."
    echo "                  See sessions/README.md"
    echo ""
    echo "The folder you run in is always read-write. Inside every mounted"
    echo "folder, .git and the paths in dangerous-paths.txt are covered so"
    echo "the agent cannot write them. That list cannot be complete, so at"
    echo "exit the run reports every auto-run file that appeared during the"
    echo "session. Read it before you commit."
}


# =============================================================================
#  What is specific to Claude Code
# =============================================================================

# The image name is deliberately NOT "agent-claude". That is what the older
# safe-agent launcher builds, from a different Dockerfile. Sharing the name
# would let these commands silently reuse an image built by that older recipe —
# one that may still contain git. A separate name keeps the two independent.
IMAGE="safer-agent-claude"
DOCKERFILE="$DOCKER_DIR/Dockerfile.claude"

VERSION_COMMAND=(claude --version)
DEFAULT_COMMAND=(claude)

CFG_HOST="$HOME/.claude"                 # on your Mac
CFG_CONT="/home/agent/.claude"           # inside the container

# Where macOS keeps the token. Confirm the name on your Mac with:
#     security find-generic-password -s "Claude Code-credentials" -w
KEYCHAIN_SERVICE="Claude Code-credentials"

# The sandbox's own token, kept between runs. Inside the launcher folder, so
# --add and --rw refuse it, and ignored by git like the rest of history/.
# See seed_credentials() and save_credentials() below.
CRED_STORE="$HISTORY_DIR/claude/credentials.json"

# The config folder is NOT mounted directly. See build_config() below.
#
# ~/.claude.json is listed as well: it lives outside the .claude folder and
# --add or --ro must not be able to reach it either.
PROTECTED_ROOTS+=("$CFG_HOST" "$HOME/.claude.json")

# ---------------------------------------------------------------------------
#  Environment variables for the container.
#
#  Claude Code contacts several hosts by default that have nothing to do with
#  the work: telemetry, error reporting, the update check, artifact loading,
#  and MCP connectors. Two reasons to switch them off rather than allow them:
#
#  1. Fewer entries on the allowlist is better.
#  2. A blocked host does not fail cleanly — it times out. Left alone, these
#     turn into multi-second stalls at startup, which is exactly what makes
#     people give up on an allowlist.
# ---------------------------------------------------------------------------
TOOL_ENV=(
    --env CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1  # telemetry + errors
    --env DISABLE_AUTOUPDATER=1                       # update check
    --env CLAUDE_CODE_DISABLE_ARTIFACT=1              # artifact loading
    --env ENABLE_CLAUDEAI_MCP_SERVERS=false           # connectors, ON by default
)

# ---------------------------------------------------------------------------
#  ~/.claude.json mixes per-project session state, rewritten constantly, with
#  `mcpServers`, which starts processes on your Mac at launch. So it can be
#  neither read-only nor shared. Copy it in; throw the copy away.
#
#  This file lives at $HOME/.claude.json, OUTSIDE the .claude folder, so
#  build_config() does not cover it.
# ---------------------------------------------------------------------------
add_copy "$HOME/.claude.json" "/home/agent/.claude.json"


# ---------------------------------------------------------------------------
#  Seed the token for the sandbox.
#
#  THE SANDBOX HAS ITS OWN LOGIN, SEPARATE FROM YOUR MAC'S
#
#  The first version of this launcher copied the token from the Keychain at
#  every start, and that forced a /login at every start. The reason is how a
#  token renews. An access token lasts about eight hours. When Claude Code
#  renews it, the server hands out a new refresh token, and the old refresh
#  token stops working. The renewal ran inside the sandbox, in the throwaway
#  copy, so the Keychain kept the OLD refresh token — dead from the first
#  sandbox renewal on. Every later start seeded a dead token, the renewal
#  failed, and Claude Code asked for a login.
#
#  So the sandbox keeps its own token, in $CRED_STORE. Order at start:
#
#    1. $CRED_STORE, when it holds a usable token;
#    2. else the Keychain, once, as a starter. If that token is already dead,
#       Claude Code asks for one login, and the result is saved at exit;
#    3. else ~/.claude/.credentials.json, the Linux location, usually absent
#       on a Mac;
#    4. else nothing: run /login inside the sandbox, once.
#
#  The Keychain is read, never written. Your Mac's own Claude Code keeps its
#  own login, and the two never rotate each other's token.
#
#  Whatever lands here is a throwaway copy inside the container; see
#  build_config(). save_credentials() copies the renewed token back out.
# ---------------------------------------------------------------------------
seed_credentials() {
    local dest="$CUR_BASE/.credentials.json"

    if token_file_ok "$CRED_STORE"; then
        cp "$CRED_STORE" "$dest"
        chmod 0600 "$dest"
        echo "Login: the sandbox's own token, $(token_expiry_note "$dest")."
        return 0
    fi

    if [[ -e "$CRED_STORE" ]]; then
        echo "Login: $CRED_STORE is not a usable token; ignored."
    fi

    # `security` exists only on macOS, so Linux skips straight to the file.
    if command -v security >/dev/null 2>&1 \
       && seed_in .credentials.json \
              security find-generic-password -s "$KEYCHAIN_SERVICE" -w
    then
        if token_file_ok "$dest"; then
            echo "Login: seeded from the Keychain as a starter. If Claude Code asks"
            echo "       for a login anyway, do it once. The sandbox keeps the result."
            return 0
        fi

        rm -f "$dest"
        echo "Login: the Keychain entry was not in the expected form; ignored."
    fi

    if [[ -f "$CFG_HOST/.credentials.json" ]]; then
        copy_in .credentials.json
        echo "Login: seeded from $CFG_HOST/.credentials.json"
        return 0
    fi

    echo "Login: no token found. Run /login inside the sandbox, once."
}

# ---------------------------------------------------------------------------
#  Read the expiry out of a token file: the "expiresAt" value, in milliseconds
#  since 1970. Prints nothing when the file has none.
#
#  sed rather than a JSON parser: the file is one line written by Claude Code,
#  and the launcher must not depend on python or jq being on your Mac. Only the
#  number is printed; the token itself never reaches the terminal.
# ---------------------------------------------------------------------------
token_expiry() {
    sed -n 's/.*"expiresAt":[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$1" 2>/dev/null \
        | head -n 1
}

# "expires in 5 h 12 min" or "expired 3 h ago", for the startup line.
token_expiry_note() {
    local ms now diff
    ms="$(token_expiry "$1")"
    now="$(date +%s)"
    diff=$(( ms / 1000 - now ))

    if (( diff >= 0 )); then
        echo "expires in $(( diff / 3600 )) h $(( diff % 3600 / 60 )) min"
    else
        echo "expired $(( -diff / 3600 )) h ago, Claude Code renews it"
    fi
}

# ---------------------------------------------------------------------------
#  Is this a token file the sandbox can use?
#
#  A cheap shape check, not a validation of the token: a plain file, small,
#  with the keys Claude Code writes and a numeric expiry. It runs on every
#  source before seeding AND on the sandbox's file before saving. The second
#  use is the one that matters: at exit, that file is agent output.
#
#  NO SYMLINKS, deliberately. The copy out runs on your Mac. A link the agent
#  planted inside the container would be followed on your Mac's filesystem,
#  which would copy any file of yours into the store, and from there into the
#  next sandbox. `-L` refuses the link; `-f` after it means a real file.
# ---------------------------------------------------------------------------
token_file_ok() {
    local f="$1"

    [[ ! -L "$f" && -f "$f" ]]            || return 1
    [[ "$(wc -c < "$f")" -lt 65536 ]]     || return 1   # a real one is < 1 KB
    grep -q '"claudeAiOauth"' "$f"        || return 1
    grep -q '"accessToken"'   "$f"        || return 1
    grep -q '"refreshToken"'  "$f"        || return 1
    [[ -n "$(token_expiry "$f")" ]]
}

# ---------------------------------------------------------------------------
#  Save the sandbox's token at exit. cleanup() in the shared library calls
#  safer_tool_exit, below, before it deletes the throwaway copy.
#
#  NEWEST WINS. Several sandboxes run at once, and they all start from the same
#  token. One of them may renew during the day; the others keep the old token.
#  If each exit simply overwrote the store, the last one out could put the old
#  token over the new one. So the store is replaced only when the sandbox's
#  expiry is later than the store's. Equal means the same token: nothing to do.
#
#  A sandbox killed with kill -9 never reaches this point. A renewal it made is
#  lost, and the next start uses the older token in the store. That one usually
#  still renews; if not, /login once.
#
#  Two sandboxes that BOTH renewed and exit in the same second can still leave
#  the older of the two renewals behind. That needs two sessions of over eight
#  hours ending together; the cost is one /login.
# ---------------------------------------------------------------------------
save_credentials() {
    local src="${CUR_BASE:-}/.credentials.json"
    local new old tmp

    [[ -n "${CUR_BASE:-}" ]]  || return 0
    token_file_ok "$src"      || return 0

    new="$(token_expiry "$src")"
    if token_file_ok "$CRED_STORE"; then
        old="$(token_expiry "$CRED_STORE")"
        [[ "$new" -gt "$old" ]] || return 0
    fi

    mkdir -p "$(dirname "$CRED_STORE")"
    chmod 0700 "$(dirname "$CRED_STORE")"

    # Write beside the store and rename, so another sandbox exiting at the same
    # moment never reads a half-written file.
    tmp="$CRED_STORE.$$"
    cp "$src" "$tmp"
    chmod 0600 "$tmp"
    mv -f "$tmp" "$CRED_STORE"
    echo "Login: renewed token saved for the next run."
}

safer_tool_exit() {
    save_credentials
}


# ---------------------------------------------------------------------------
#  Build the container's ~/.claude as a throwaway copy.
#
#  Read the config strategy essay in lib/safer-common.sh first — it explains
#  why this is a copy rather than a mount, and why that removes the hook risk
#  instead of merely containing it.
# ---------------------------------------------------------------------------
build_config() {
    local slug

    config_root "$CFG_HOST" "$CFG_CONT" claude

    # Rewritten when you run /effort, /model and friends.
    copy_in settings.json       json
    copy_in settings.local.json json

    # Authentication. The token is a real writable FILE in the throwaway copy,
    # so Claude Code can save its hourly renewal, and /login works inside the
    # sandbox. Do not make it a read-only single-file bind mount. That fails
    # twice over: the readonly flag blocks the write, and a rename cannot
    # replace a mount point — the same EBUSY fault described for settings.json
    # at the top of this file. The session then dies after about an hour,
    # because the token can never be renewed.
    #
    # Read-only is not the thing protecting your Mac; the copy is. Neither your
    # Keychain nor your file is reachable from the container. What the agent
    # writes here goes one place only: through the shape check in
    # save_credentials(), into the sandbox's own token file, and from there
    # into the next sandbox. Reading the token stays possible, and what makes a
    # read harmless is the network, which gives a stolen token nowhere to go.
    seed_credentials

    # Your own commands, subagents, skills and instructions, so the sandbox
    # behaves like your normal setup.
    ro_back statusline-command.sh CLAUDE.md \
            plugins commands agents skills hooks output-styles

    # This project's transcript, so history persists. Only THIS project: the
    # folder name is the project path with every character that is not a letter
    # or digit replaced by a dash. Transcripts the agent writes for any other
    # project land in the throwaway copy and are discarded.
    slug="$(project_slug "$HOST_PATH")"
    rw_back "projects/$slug"

    echo "History for this project: $CFG_HOST/projects/$slug"
    echo "Config: throwaway copy — settings changed in the sandbox do not persist."
}


# =============================================================================
#  Read the command line
#
#  Only --effort is handled here. Everything else is shared, so it goes to
#  parse_common_arg. See section 11 of lib/safer-common.sh.
# =============================================================================

EFFORT=""

while [[ $# -gt 0 ]]; do             # $# = how many arguments are left
    case "$1" in
        --effort)
            if [[ $# -lt 2 ]]; then
                echo "Error: --effort requires a LEVEL argument" >&2
                exit 1
            fi
            # Validate here rather than passing a typo through to the tool,
            # where it would either be ignored silently or produce a confusing
            # message much later.
            case "$2" in
                low|medium|high|xhigh|max)
                    EFFORT="$2"
                    ;;
                *)
                    echo "Error: unknown effort level '$2'" >&2
                    echo "Valid levels: low medium high xhigh max" >&2
                    exit 1
                    ;;
            esac
            shift 2
            ;;

        *)
            parse_common_arg "$@"
            shift "$ARGS_CONSUMED"
            ;;
    esac
done

safer_resolve_command

# ---------------------------------------------------------------------------
#  Effort level.
#
#  Optional. /effort works inside the sandbox, so this flag is mainly for
#  unattended runs where nobody is there to type it.
#
#  BE AWARE: setting this environment variable OVERRIDES /effort for the whole
#  session. Running /effort afterwards reports "Not applied" and changes
#  nothing. Leave the flag off if you want to adjust effort while you work.
# ---------------------------------------------------------------------------
if [[ -n "$EFFORT" ]]; then
    TOOL_ENV+=(--env "CLAUDE_CODE_EFFORT_LEVEL=$EFFORT")
    echo "Effort level: $EFFORT (this session only)"
fi


# =============================================================================
#  Assemble and run
# =============================================================================

safer_check_workdir          # sets HOST_PATH; build_config needs it
safer_ensure_agent_image

build_config
apply_config_copies          # ~/.claude.json, registered with add_copy above

safer_protect_paths
safer_setup_network
safer_run
